{
  "name": "@./auth-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node dist/main.js"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.2",
    "@prisma/client": "^6.7.0",
    "tslib": "^2.3.0",
    "swagger-ui-express": "^4.6.0",
    "bcryptjs": "^2.4.3",
    "ejs": "^3.1.9",
    "nodemailer": "^6.9.0",
    "path": "^0.12.7",
    "swagger-autogen": "^2.2.1",
    "stripe": "^12.0.0",
    "kafkajs": "^2.2.4",
    "ioredis": "^5.3.0",
    "crypto": "^1.0.1",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/cookie-parser": "^1.4.3",
    "@types/node": "^20.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/nodemailer": "^6.4.0",
    "prisma": "^6.7.0"
  },
  "nx": {
    "name": "auth-service",
    "projectType": "application",
    "sourceRoot": "auth-service/src",
    "targets": {
      "serve": {
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "auth-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "auth-service:build:development"
          },
          "production": {
            "buildTarget": "auth-service:build:production"
          }
        }
      },
      "clean": {
        "executor": "nx:run-commands",
        "options": {
          "command": "rimraf apps/auth-service/dist && rimraf apps/auth-service/node_modules"
        }
      }
    }
  }
}