{
  "name": "@./api-gateway",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node dist/main.js"
  },
  "dependencies": {
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "express-http-proxy": "^1.6.3",
    "morgan": "^1.10.0",
    "express-rate-limit": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "@prisma/client": "^6.7.0",
    "typescript": "^5.0.0",
    "tslib": "^2.6.0",
    "dotenv": "^16.0.0",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/cookie-parser": "^1.4.3",
    "@types/node": "^20.0.0",
    "@types/morgan": "^1.9.4",
    "prisma": "^6.7.0"
  },
  "nx": {
    "targets": {
      "serve": {
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@./api-gateway:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@./api-gateway:build:development"
          },
          "production": {
            "buildTarget": "@./api-gateway:build:production"
          }
        }
      },
      "clean": {
        "executor": "nx:run-commands",
        "options": {
          "command": "rimraf apps/api-gateway/dist && rimraf apps/api-gateway/node_modules"
        }
      }
    }
  }
}
