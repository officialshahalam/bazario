{
  "name": "@./chatting-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node dist/main.js"
  },
   "dependencies": {
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "socket.io": "^4.7.4",
    "dotenv": "^16.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "cookie-parser": "^1.4.6",
    "swagger-ui-express": "^4.6.0",
    "swagger-autogen": "^2.2.1",
    "path": "^0.12.7",
    "@prisma/client": "^6.7.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "ws": "^8.0.0",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/cookie-parser": "^1.4.3",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "prisma": "^6.7.0"
  },
  "nx": {
    "targets": {
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@./chatting-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@./chatting-service:build:development"
          },
          "production": {
            "buildTarget": "@./chatting-service:build:production"
          }
        }
      },
      "clean": {
        "executor": "nx:run-commands",
        "options": {
          "command": "rimraf apps/chatting-service/dist && rimraf apps/chatting-service/node_modules"
        }
      }
    }
  }
}
