{
  "name": "@./source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npx nx run-many --target=serve --all --maxParallel=10 --output-style=stream",
    "ui": "npm run user-ui & npm run seller-ui & npm run admin-ui",
    "user-ui": "npx nx run user-ui:dev --port=3000 --output-style=stream",
    "seller-ui": "npx nx run seller-ui:dev --port=3001 --output-style=stream",
    "admin-ui": "npx nx run admin-ui:dev --port=3002 --output-style=stream",
    "build": "npx nx run-many --target=build --all --parallel=3 --output-style=stream",
    "clean": "rimraf dist && nx run-many --target=clean --all --output-style=stream || true",
    "start:prod": "npx nx run-many --target=serve --projects=auth-service",
    "ui:prod": "npm run user-ui:prod & npm run seller-ui:prod & npm run admin-ui:prod",
    "user-ui:prod": "cd apps/user-ui && npx next start -p 3000",
    "seller-ui:prod": "cd apps/seller-ui && npx next start -p 3001",
    "admin-ui:prod": "cd apps/admin-ui && npx next start -p 3002",
    "docker:prod": "bash scripts/local-production.sh",
    "docker:build": "bash scripts/local-production.sh --build-only",
    "docker:run": "bash scripts/local-production.sh --run-only",
    "docker:stop": "bash scripts/local-production.sh --stop",
    "docker:clean": "bash scripts/local-production.sh --clean",
    "docker:logs": "bash scripts/local-production.sh --logs",
    "kafka:up": "docker compose -f docker-compose.production.yml up kafka zookeeper -d",
    "kafka:down": "docker compose -f docker-compose.production.yml stop kafka zookeeper"
  },
  "private": true,
